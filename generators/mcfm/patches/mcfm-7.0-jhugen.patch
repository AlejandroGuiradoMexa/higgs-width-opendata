+++ b/src/User/usercode_f77.f
@@ -131,3 +131,38 @@ c     the run of the program (itno=0).
       double precision xsec,xsec_err
       end
 c---- SSend
+
+      subroutine read_anom_env
+************************************************************************
+*   Reads JHUGen-style anomalous HZZ couplings from environment
+*   variables so they can be scanned without recompiling:
+*     MCFM_GHZ2, MCFM_GHZ4 : real parts of ghz2 (a2) and ghz4 (a3)
+*   Anomalous couplings are switched on only if one of them is set.
+************************************************************************
+      implicit none
+      include 'spinzerohiggs_anomcoupl.f'
+      character*64 val
+      integer ln
+      double precision x
+
+      call get_environment_variable('MCFM_GHZ2', val, ln)
+      if (ln .gt. 0) then
+        read(val,*) x
+        ghz2 = dcmplx(x, 0d0)
+        AllowAnomalousCouplings = 1
+      endif
+      call get_environment_variable('MCFM_GHZ4', val, ln)
+      if (ln .gt. 0) then
+        read(val,*) x
+        ghz4 = dcmplx(x, 0d0)
+        AllowAnomalousCouplings = 1
+      endif
+      if (AllowAnomalousCouplings .eq. 1) then
+c--- SM top and bottom Yukawas in the gg->H loop (their defaults are 0)
+        kappa_top = (1d0,0d0)
+        kappa_bot = (1d0,0d0)
+        write(6,*) 'read_anom_env: ghz1, ghz2, ghz4 = ',
+     &    ghz1, ghz2, ghz4
+      endif
+      return
+      end
