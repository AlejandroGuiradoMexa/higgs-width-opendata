# Draw the detector and the trajectories of the events into a VRML 2.0 file (g4_NN.wrl), for the 3D view on the
# project page. Run: build/calo e- 50 1 2.0 /tmp/vis.txt 7 macros/vrml.mac  (G4VRMLFILE_DEST_DIR sets the output folder)
/vis/open VRML2FILE
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set e+ blue
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/setDefault grey
# Keep the picture readable: only tracks that start above 1 MeV
/vis/filtering/trajectories/create/attributeFilter
/vis/filtering/trajectories/attributeFilter-0/setAttribute IMag
/vis/filtering/trajectories/attributeFilter-0/addInterval 1 MeV 1000 GeV
/vis/scene/endOfEventAction accumulate
